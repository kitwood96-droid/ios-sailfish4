sailfish wlan: install the pairwise key right after queueing msg 4/4

Seen with a TP-Link AP: msg 4/4 got no tx completion within 1 s, the AP
repeated msg 3/4, and wl_rekey() took that for a PTK rekey and dropped
the link. The firmware only completed msg 4 once the pairwise key was
installed: queue msg 4, install the key, then wait; answer a repeated msg 3.

--- a/bsd/dev/sailfish_wlan.c
+++ b/bsd/dev/sailfish_wlan.c
@@ -2557,6 +2557,31 @@
 /* The PTK (KCK, KEK, TK) and the AP's last replay counter, for group rekeys. */
 static uint8_t wl_ptk[48], wl_replay[8];
 
+/*
+ * Handshake msg 4/4 for the msg 3/4 with this replay counter, MIC under the
+ * current PTK. Only queued here: on this phone the firmware reports no tx
+ * completion for it until the pairwise key is installed (four copies sat
+ * for 1.2 s, then all completed right after the key), so the caller
+ * installs the key first and waits for the completion afterwards.
+ */
+static bool
+wl_send_m4(const uint8_t *replay)
+{
+	static uint8_t r[EK_DATA];
+	uint8_t mic[20];
+	bzero(r, sizeof(r));
+	r[0] = 1;
+	r[1] = 3;
+	r[3] = EK_DATA - 4;
+	r[4] = 2;
+	r[EK_INFO] = 0x03;                              /* secure | MIC | pairwise | v2 */
+	r[EK_INFO + 1] = 0x0a;
+	memcpy(r + EK_REPLAY, replay, 8);
+	wl_hmac_sha1(wl_ptk, 16, r, sizeof(r), NULL, 0, mic);
+	memcpy(r + EK_MIC, mic, 16);
+	return wl_data_tx(wl_bss.bssid, 0x888e, r, sizeof(r));
+}
